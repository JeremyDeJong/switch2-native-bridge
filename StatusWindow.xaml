<Window x:Class="Switch2Bridge.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch 2 Native Bridge"
        Icon="pack://application:,,,/assets/app.ico"
        Width="620" Height="680" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24,12,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Controllers" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="Summary" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Update available -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                BorderThickness="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Your controllers stay connected while it updates." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReleaseNotesButton" Content="What's new" Margin="0,0,8,0" Click="OnReleaseNotes" />
                    <Button x:Name="SkipButton" Content="Skip" Margin="0,0,8,0" Click="OnSkipUpdate" />
                    <Button x:Name="UpdateButton" Content="Update now" Click="OnUpdate" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="Pads" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="16,14" Margin="0,0,0,8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Opacity="{Binding CardOpacity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40" Height="40" CornerRadius="6" VerticalAlignment="Top"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            ToolTip="Player number">
                                        <TextBlock Text="{Binding Number}" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding LinkDetail}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding ActionsVisibility}"
                                                   ToolTip="Gaps between Bluetooth updates. A stall is a gap of 50 ms or more, which you can feel as a hitch."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Button Content="Test rumble" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                Visibility="{Binding ActionsVisibility}" Tag="{Binding Number}" Click="OnTestRumble" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding LiveVisibility}"
                                                ToolTip="Live input: left stick, right stick, gyro">
                                        <Grid Width="34" Height="34" Margin="0,0,8,0">
                                            <Ellipse Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1.5" />
                                            <Canvas>
                                                <Ellipse Width="8" Height="8" Canvas.Left="{Binding LX}" Canvas.Top="{Binding LY}"
                                                         Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Canvas>
                                        </Grid>
                                        <Grid Width="34" Height="34" Margin="0,0,10,0">
                                            <Ellipse Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1.5" />
                                            <Canvas>
                                                <Ellipse Width="8" Height="8" Canvas.Left="{Binding RX}" Canvas.Top="{Binding RY}"
                                                         Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Canvas>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Height="34" VerticalAlignment="Center">
                                            <Rectangle Width="5" Margin="0,0,3,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom"
                                                       Height="{Binding GX}" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Rectangle Width="5" Margin="0,0,3,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom"
                                                       Height="{Binding GY}" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Rectangle Width="5" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom"
                                                       Height="{Binding GZ}" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyHint" FontSize="15" Margin="0,8,0,8" TextWrapping="Wrap"
                           Text="Press any button on a controller you've paired before. For a new controller, hold its Sync button until the lights sweep." />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Each Pro Controller gets its own player. A left and right Joy-Con join into one controller." />

                <Expander x:Name="SettingsExpander" Header="Settings" Margin="0,16,0,0" HorizontalAlignment="Stretch">
                    <StackPanel Margin="0,8,0,4">
                        <TextBlock Text="Rumble strength" FontWeight="SemiBold" />
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="RumbleSlider" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False"
                                    SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                                    AutomationProperties.Name="Rumble strength" ValueChanged="OnRumbleChanged" />
                            <TextBlock x:Name="RumbleValue" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="Turn controllers off" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="After no input for" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="IdleBox" MinWidth="130" SelectionChanged="OnIdleChanged"
                                      AutomationProperties.Name="Turn controllers off after no input for" />
                        </StackPanel>
                        <CheckBox x:Name="SleepBox" Content="When the PC goes to sleep" Margin="0,6,0,0" Click="OnPowerOptionClick" />
                        <CheckBox x:Name="QuitBox" Content="When the bridge quits" Margin="0,2,0,12" Click="OnPowerOptionClick" />

                        <TextBlock Text="Updates" FontWeight="SemiBold" />
                        <CheckBox x:Name="UpdatesBox" Content="Check for updates automatically" Margin="0,6,0,0" Click="OnUpdatesOptionClick" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Check now" Click="OnCheckUpdates" Margin="0,0,12,0" />
                            <TextBlock x:Name="VersionText" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Content="Open battery logs" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnOpenBatteryLogs" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <CheckBox x:Name="AutostartBox" Content="Start with Windows" VerticalAlignment="Center"
                      Click="OnAutostartClick" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Open log" Margin="0,0,8,0" Click="OnOpenLog" />
                <Button x:Name="SteamButton" Content="Open Steam" Click="OnOpenSteam" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
