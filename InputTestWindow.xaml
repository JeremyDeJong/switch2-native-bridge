<Window x:Class="Switch2Bridge.InputTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test inputs"
        Icon="pack://application:,,,/assets/app.ico"
        Width="560" Height="520" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24,12,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="Heading" Text="Test inputs" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="Progress" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="Chips" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,10">
            <StackPanel Margin="0,0,24,0">
                <Grid Width="64" Height="64">
                    <Ellipse Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1.5" />
                    <Canvas><Ellipse x:Name="LeftDot" Width="12" Height="12" Fill="{DynamicResource AccentFillColorDefaultBrush}" /></Canvas>
                </Grid>
                <TextBlock Text="Left stick" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,24,0">
                <Grid Width="64" Height="64">
                    <Ellipse Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1.5" />
                    <Canvas><Ellipse x:Name="RightDot" Width="12" Height="12" Fill="{DynamicResource AccentFillColorDefaultBrush}" /></Canvas>
                </Grid>
                <TextBlock Text="Right stick" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Height="64" HorizontalAlignment="Center">
                    <Rectangle x:Name="GyroX" Width="10" Margin="0,0,5,0" VerticalAlignment="Bottom" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Rectangle x:Name="GyroY" Width="10" Margin="0,0,5,0" VerticalAlignment="Bottom" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Rectangle x:Name="GyroZ" Width="10" VerticalAlignment="Bottom" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                </StackPanel>
                <TextBlock Text="Gyro" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="3">
            <TextBlock Margin="0,0,100,0" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Steam and games don't receive this controller's input while this window is open. If something lights up here but not in a game, the bridge received it, so check Steam or the game." />
            <Button Content="Start over" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnReset" />
        </Grid>
    </Grid>
</Window>
